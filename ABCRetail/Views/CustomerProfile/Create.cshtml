@model ABCRetail.Models.CustomerProfile
@{
    ViewData["Title"] = "Add Customer";
}

<h2 class="mb-4">Add New Customer</h2>

<div class="card shadow-sm p-4" style="max-width:600px;">
    <form asp-action="Create" method="post">
        @Html.AntiForgeryToken()

        <div class="mb-3">
            <label asp-for="FirstName" class="form-label fw-semibold"></label>
            <input asp-for="FirstName" class="form-control" placeholder="e.g. John" required />
            <span asp-validation-for="FirstName" class="text-danger small"></span>
        </div>

        <div class="mb-3">
            <label asp-for="LastName" class="form-label fw-semibold"></label>
            <input asp-for="LastName" class="form-control" placeholder="e.g. Smith" required />
            <span asp-validation-for="LastName" class="text-danger small"></span>
        </div>

        <div class="mb-3">
            <label asp-for="Email" class="form-label fw-semibold"></label>
            <input asp-for="Email" type="email" class="form-control" placeholder="e.g. john@example.com" required />
            <span asp-validation-for="Email" class="text-danger small"></span>
        </div>

        <div class="mb-3">
            <label asp-for="Phone" class="form-label fw-semibold"></label>
            <input asp-for="Phone" class="form-control" placeholder="e.g. 083 123 4567" />
        </div>

        <div class="mb-3">
            <label asp-for="Address" class="form-label fw-semibold"></label>
            <input asp-for="Address" class="form-control" placeholder="e.g. 12 Main Street" />
        </div>

        <div class="mb-3">
            <label asp-for="City" class="form-label fw-semibold"></label>
            <input asp-for="City" class="form-control" placeholder="e.g. Johannesburg" />
        </div>

        <div class="d-flex gap-2 mt-3">
            <button type="submit" class="btn btn-dark">Save Customer</button>
            <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
        </div>
    </form>
</div>
