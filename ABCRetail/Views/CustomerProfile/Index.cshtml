@model List<ABCRetail.Models.CustomerProfile>
@{
    ViewData["Title"] = "Customer Profiles";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2>Customer Profiles</h2>
    <a asp-action="Create" class="btn btn-dark">+ Add Customer</a>
</div>

@if (!Model.Any())
{
    <div class="alert alert-info">No customer profiles found. Add your first customer above.</div>
}
else
{
    <div class="table-responsive">
        <table class="table table-striped table-hover align-middle">
            <thead class="table-dark">
                <tr>
                    <th>Name</th>
                    <th>Email</th>
                    <th>Phone</th>
                    <th>City</th>
                    <th>Date Registered</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var customer in Model)
                {
                    <tr>
                        <td>@customer.FirstName @customer.LastName</td>
                        <td>@customer.Email</td>
                        <td>@customer.Phone</td>
                        <td>@customer.City</td>
                        <td>@customer.DateRegistered.ToString("dd MMM yyyy")</td>
                        <td>
                            <a asp-action="Edit" asp-route-rowKey="@customer.RowKey" class="btn btn-sm btn-outline-secondary">Edit</a>
                            <a asp-action="Delete" asp-route-rowKey="@customer.RowKey" class="btn btn-sm btn-outline-danger">Delete</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
