@model List<string>

@{
    ViewData["Title"] = "Queue Messages";
}

<div class="container">
    <h1 class="mt-4">📋 Order Processing Queue</h1>
    <p class="lead">View and manage order processing and inventory management messages.</p>

    <div class="row mb-3">
        <div class="col-md-6">
            <div class="card">
                <div class="card-body">
                    <h5 class="card-title">Queue Information</h5>
                    <p><strong>Queue Name:</strong> orderqueue</p>
                    <p><strong>Total Messages:</strong> @ViewBag.QueueLength</p>
                    <p><strong>Messages Displayed:</strong> @ViewBag.MessageCount</p>
                </div>
            </div>
        </div>
        <div class="col-md-6">
            <div class="card">
                <div class="card-body">
                    <h5 class="card-title">Queue Actions</h5>
                    <form asp-action="SendTestMessage" method="post" style="display:inline;">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="btn btn-primary btn-sm">Send Test Message</button>
                    </form>
                    <form asp-action="ProcessMessages" method="post" style="display:inline;">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="btn btn-warning btn-sm">Process Messages</button>
                    </form>
                    <form asp-action="ClearQueue" method="post" style="display:inline;">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="btn btn-danger btn-sm" onclick="return confirm('Are you sure you want to clear all messages?')">Clear Queue</button>
                    </form>
                </div>
            </div>
        </div>
    </div>

    <div class="card mt-3">
        <div class="card-header">
            <h5>Queue Messages (@(Model?.Count ?? 0) messages displayed)</h5>
        </div>
        <div class="card-body">
            @if (Model != null && Model.Any())
            {
                <div class="table-responsive">
                    <table class="table table-striped table-hover">
                        <thead>
                            <tr>
                                <th>#</th>
                                <th>Message</th>
                                <th>Timestamp</th>
                            </tr>
                        </thead>
                        <tbody>
                            @{
                                int index = 1;
                                foreach (var message in Model)
                                {
                                    <tr>
                                        <td>@index</td>
                                        <td>@message</td>
                                        <td>@DateTime.UtcNow.ToString("yyyy-MM-dd HH:mm:ss")</td>
                                    </tr>
                                    index++;
                                }
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <div class="text-center py-4">
                    <p class="text-muted">No messages in the queue.</p>
                    <p>Click "Send Test Message" to add a sample message.</p>
                </div>
            }
        </div>
    </div>
</div>