@model List<ABCRetail.Models.Product>
@{
    ViewData["Title"] = "Products";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2>Products</h2>
    <a asp-action="Create" class="btn btn-dark">+ Add Product</a>
</div>

@if (!Model.Any())
{
    <div class="alert alert-info">No products found. Add your first product above.</div>
}
else
{
    <div class="row g-4">
        @foreach (var product in Model)
        {
            <div class="col-md-4">
                <div class="card shadow-sm h-100">
                    @if (!string.IsNullOrEmpty(product.ImageUrl))
                    {
                        <img src="@product.ImageUrl" class="card-img-top" alt="@product.ProductName"
                             style="height:200px; object-fit:cover;" />
                    }
                    else
                    {
                        <div class="bg-secondary text-white text-center py-5">No Image</div>
                    }
                    <div class="card-body">
                        <h5 class="card-title">@product.ProductName</h5>
                        <p class="text-muted small mb-1">@product.Category</p>
                        <p class="card-text small">@product.Description</p>
                        <p class="fw-bold">R @product.Price.ToString("F2")</p>
                        <p class="small text-muted">Stock: @product.StockQuantity</p>
                    </div>
                    <div class="card-footer d-flex gap-2">
                        <a asp-action="Edit" asp-route-rowKey="@product.RowKey" class="btn btn-sm btn-outline-secondary w-50">Edit</a>
                        <a asp-action="Delete" asp-route-rowKey="@product.RowKey" class="btn btn-sm btn-outline-danger w-50">Delete</a>
                    </div>
                </div>
            </div>
        }
    </div>
}
