@model ABCRetail.Models.Product
@{
    ViewData["Title"] = "Edit Product";
}

<h2 class="mb-4">Edit Product</h2>

<div class="card shadow-sm p-4" style="max-width:600px;">
    <form asp-action="Edit" method="post" enctype="multipart/form-data">
        @Html.AntiForgeryToken()
        <input type="hidden" asp-for="RowKey" />
        <input type="hidden" asp-for="PartitionKey" />
        <input type="hidden" asp-for="ETag" />
        <input type="hidden" asp-for="ImageUrl" />

        <div class="mb-3">
            <label asp-for="ProductName" class="form-label fw-semibold"></label>
            <input asp-for="ProductName" class="form-control" required />
        </div>

        <div class="mb-3">
            <label asp-for="Category" class="form-label fw-semibold"></label>
            <input asp-for="Category" class="form-control" required />
        </div>

        <div class="mb-3">
            <label asp-for="Description" class="form-label fw-semibold"></label>
            <textarea asp-for="Description" class="form-control" rows="3"></textarea>
        </div>

        <div class="mb-3">
            <label asp-for="Price" class="form-label fw-semibold"></label>
            <input asp-for="Price" type="number" step="0.01" class="form-control" required />
        </div>

        <div class="mb-3">
            <label asp-for="StockQuantity" class="form-label fw-semibold"></label>
            <input asp-for="StockQuantity" type="number" class="form-control" required />
        </div>

        <div class="mb-3">
            <label class="form-label fw-semibold">Product Image</label>
            @if (!string.IsNullOrEmpty(Model.ImageUrl))
            {
                <div class="mb-2">
                    <img src="@Model.ImageUrl" alt="Current image" style="max-height:150px; border-radius:6px;" />
                    <p class="form-text">Current image shown above. Upload a new one to replace it.</p>
                </div>
            }
            <input type="file" name="imageFile" class="form-control" accept="image/*" />
        </div>

        <div class="d-flex gap-2 mt-3">
            <button type="submit" class="btn btn-dark">Update Product</button>
            <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
        </div>
    </form>
</div>
