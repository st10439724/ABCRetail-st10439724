@model ABCRetail.Models.Product
@{
    ViewData["Title"] = "Add Product";
}

<h2 class="mb-4">Add New Product</h2>

<div class="card shadow-sm p-4" style="max-width:600px;">
    <form asp-action="Create" method="post" enctype="multipart/form-data">
        @Html.AntiForgeryToken()

        <div class="mb-3">
            <label asp-for="ProductName" class="form-label fw-semibold"></label>
            <input asp-for="ProductName" class="form-control" placeholder="e.g. Wireless Headphones" required />
            <span asp-validation-for="ProductName" class="text-danger small"></span>
        </div>

        <div class="mb-3">
            <label asp-for="Category" class="form-label fw-semibold"></label>
            <input asp-for="Category" class="form-control" placeholder="e.g. Electronics" required />
            <span asp-validation-for="Category" class="text-danger small"></span>
        </div>

        <div class="mb-3">
            <label asp-for="Description" class="form-label fw-semibold"></label>
            <textarea asp-for="Description" class="form-control" rows="3" placeholder="Brief product description..."></textarea>
        </div>

        <div class="mb-3">
            <label asp-for="Price" class="form-label fw-semibold"></label>
            <input asp-for="Price" type="number" step="0.01" class="form-control" placeholder="e.g. 299.99" required />
            <span asp-validation-for="Price" class="text-danger small"></span>
        </div>

        <div class="mb-3">
            <label asp-for="StockQuantity" class="form-label fw-semibold"></label>
            <input asp-for="StockQuantity" type="number" class="form-control" placeholder="e.g. 50" required />
            <span asp-validation-for="StockQuantity" class="text-danger small"></span>
        </div>

        <div class="mb-3">
            <label class="form-label fw-semibold">Product Image</label>
            <input type="file" name="imageFile" class="form-control" accept="image/*" />
            <div class="form-text">Upload an image for this product. Stored in Azure Blob Storage.</div>
        </div>

        <div class="d-flex gap-2 mt-3">
            <button type="submit" class="btn btn-dark">Save Product</button>
            <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
        </div>
    </form>
</div>
