@model ABCRetail.Models.Product
@{
    ViewData["Title"] = "Delete Product";
}

<h2 class="mb-4 text-danger">Delete Product</h2>

<div class="card shadow-sm p-4" style="max-width:500px;">
    <p>Are you sure you want to delete this product? The image will also be removed from storage.</p>
    <hr />
    @if (!string.IsNullOrEmpty(Model.ImageUrl))
    {
        <img src="@Model.ImageUrl" alt="@Model.ProductName" style="max-height:150px; border-radius:6px;" class="mb-3" />
    }
    <dl class="row">
        <dt class="col-sm-5">Product Name</dt>
        <dd class="col-sm-7">@Model.ProductName</dd>
        <dt class="col-sm-5">Category</dt>
        <dd class="col-sm-7">@Model.Category</dd>
        <dt class="col-sm-5">Price</dt>
        <dd class="col-sm-7">R @Model.Price.ToString("F2")</dd>
        <dt class="col-sm-5">Stock</dt>
        <dd class="col-sm-7">@Model.StockQuantity units</dd>
    </dl>
    <form asp-action="Delete" method="post">
        @Html.AntiForgeryToken()
        <input type="hidden" name="rowKey" value="@Model.RowKey" />
        <input type="hidden" name="imageUrl" value="@Model.ImageUrl" />
        <div class="d-flex gap-2 mt-3">
            <button type="submit" class="btn btn-danger">Yes, Delete</button>
            <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
        </div>
    </form>
</div>
